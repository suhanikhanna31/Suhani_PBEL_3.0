# ---- watsonx.ai ----
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ---- watsonx Assistant (webhook auth) ----
ASSISTANT_WEBHOOK_SECRET=change-me

# ---- Database (Neon Postgres) ----
# Set this to your Neon connection string to load email data from the live
# `emails` table instead of a local data/raw/email.csv file. Leave blank to
# keep using local CSV / synthetic data.
DATABASE_URL=

# ---- App ----
APP_ENV=development
ANONYMIZATION_SALT=x7k2m9qp4wz8vt1n6ycr3fh5
CONSENT_REQUIRED=true
AUDIT_LOG_PATH=data/processed/audit_log.jsonl

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
